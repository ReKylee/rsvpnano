{
  "name": "zlib",
  "version": "1.3.2",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/madler/zlib.git"
  },
  "build": {
    "srcDir": "upstream",
    "includeDir": "upstream",
    "srcFilter": [
      "+<adler32.c>",
      "+<crc32.c>",
      "+<deflate.c>",
      "+<inffast.c>",
      "+<inflate.c>",
      "+<inftrees.c>",
      "+<trees.c>",
      "+<zutil.c>"
    ]
  }
}
